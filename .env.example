# ─────────────────────────────────────────────────────────────────────
# agentic-ai-aws-nanodegree-project-1  —  environment template
#
#   cp .env.example .env      then fill in the blanks
#
# .env is git-ignored. Never commit real keys.
# Load it into your shell before running the scripts:
#   bash / git-bash :  set -a && source .env && set +a
#   PowerShell      :  Get-Content .env | ForEach-Object {
#                        if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                          [Environment]::SetEnvironmentVariable(
#                            $matches[1].Trim(), $matches[2].Trim(), 'Process') } }
# ─────────────────────────────────────────────────────────────────────

# ---- AWS account used for THIS project -----------------------------
# Needs CloudFormation, Lambda, DynamoDB, IAM, S3, Bedrock and
# Bedrock AgentCore permissions. The course pins us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# ---- project settings (defaults match the course) ------------------
TOOL_STACK_NAME=bug-report-tool-stack
TESTING_STACK_NAME=bug-report-testing-stack
HARNESS_NAME=support_chatbot
GATEWAY_TARGET_NAME=bugreports
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
EVAL_MODEL_IDENTIFIER=my-support-chatbot
DDB_TABLE_NAME=bug-report-tool-stack-bug-reports
SUPPORT_PHONE=1-800-555-0199

# ---- offline test suite --------------------------------------------
# 1 = tests/ run entirely offline against the fake harness (no AWS calls).
# The offline suite is the default and needs no credentials at all.
OFFLINE_TESTS=1
